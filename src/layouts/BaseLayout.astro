---
/**
 * Root layout: header, footer and metadata shared by every page.
 *
 * Search tags are produced here from a single source, so a title or description
 * cannot drift between the `<head>` and the structured data.
 *
 * Locale handling lives here too. Each page passes its own translated paths for
 * both locales; the layout derives the canonical URL, the `hreflang` alternates
 * and the dictionary, so no page has to reason about it.
 */
import '@/styles/global.css';
import '@/styles/components.css';

import { SITE } from '@/consts';
import { buildStructuredData, serializeJsonLd } from '@/utils/seo';
import {
  getDictionary,
  HREFLANG,
  OG_LOCALES,
  toLocale,
  DEFAULT_LOCALE,
  type Locale,
} from '@/i18n';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  /** Page title, without the company name. */
  title: string;
  /** Description shown in search results. */
  description: string;
  /**
   * Path of this page in each locale, starting with a slash.
   *
   * Required rather than derived for indexable pages: URL segments are
   * translated, so the layout cannot compute the counterpart of
   * `/cloud-souverain/` on its own. Omit a locale when the page has no
   * translation, and omit the whole prop on pages that are not translatable
   * (an error page, for instance) — the layout then falls back to the actual
   * request path.
   */
  paths?: Partial<Record<Locale, string>>;
  /** Certifications to declare in structured data. */
  certifications?: readonly string[];
  /** Prevents indexing, for utility pages. */
  noindex?: boolean;
  /** Open Graph type; `article` on blog posts, `website` elsewhere. */
  ogType?: 'website' | 'article';
  /** Publication and revision dates, required by `og:type=article`. */
  articleTimes?: { published: Date; updated?: Date };
  /** Specific share image, otherwise the site image is used. */
  ogImage?: string;
}

const {
  title,
  description,
  paths = {},
  certifications = [],
  noindex = false,
  ogType = 'website',
  articleTimes,
  ogImage = `${SITE.url}/images/og-cover.jpg`,
} = Astro.props;

const locale = toLocale(Astro.currentLocale) ?? DEFAULT_LOCALE;
const t = getDictionary(locale);

/**
 * Path of this page in the current locale.
 *
 * Falls back to the request path, which covers pages that declare no
 * translation pair: an error page still needs a canonical URL and a path for its
 * structured data, and the path it was rendered at is the correct answer.
 */
const path = paths[locale] ?? Astro.url.pathname;
const pageUrl = new URL(path, Astro.site).href;
const alternateUrl = paths[locale === 'fr' ? 'en' : 'fr'] ?? null;

/** Home pages carry their own full title; others get the company suffix. */
const isHome = path === '/' || path === '/en/';
const fullTitle = isHome
  ? `${SITE.name} — ${t.hero.eyebrow}`
  : `${title} — ${SITE.name}`;

const structuredData = buildStructuredData({
  pageUrl,
  pageTitle: fullTitle,
  pageDescription: description,
  locale,
  certifications,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {
      /* Reciprocal alternates. Each language points at its own translation and
         at itself; a language that is absent is simply not declared, which is
         safer than pointing hreflang at the wrong URL. */
      Object.entries(HREFLANG).map(([code, hreflang]) => {
        const target = paths[code as Locale];
        return target ? (
          <link rel="alternate" hreflang={hreflang} href={new URL(target, Astro.site).href} />
        ) : null;
      })
    }
    {
      paths.fr && <link rel="alternate" hreflang="x-default" href={new URL(paths.fr, Astro.site).href} />
    }

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      alternateUrl && (
        <meta property="og:locale:alternate" content={OG_LOCALES[locale === 'fr' ? 'en' : 'fr']} />
      )
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.footer.tagline} />

    {
      articleTimes && (
        <>
          <meta
            property="article:published_time"
            content={articleTimes.published.toISOString()}
          />
          {articleTimes.updated && (
            <meta property="article:modified_time" content={articleTimes.updated.toISOString()} />
          )}
          <meta property="article:author" content={SITE.founder} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#05031a" />

    <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <Header t={t} locale={locale} alternateUrl={alternateUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} locale={locale} />
  </body>
</html>
