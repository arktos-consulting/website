---
/**
 * Présentation du parcours et des rattachements professionnels.
 *
 * Les éléments biographiques sont datés et renvoient à des profils externes
 * vérifiables. C'est ce qui distingue une page « qui je suis » utile d'un
 * paragraphe d'auto-promotion, pour un lecteur comme pour un moteur de réponse.
 */
import { SITE, PROFILES } from '@/consts';
import { totalYears, freelanceYears } from '@/utils/career';
import { CLIENT_LOGOS } from '@/data/content';
import SectionHeading from '@/components/SectionHeading.astro';

const years = totalYears();
const independentYears = freelanceYears();

const credentials = [
  { label: 'Meetup AWS Lyon', detail: 'Co-organisateur', href: PROFILES.meetup },
  { label: 'Cloud Partners', detail: 'Co-créateur, collectif AWS', href: PROFILES.cloudPartners },
  { label: 'Hartza Capital', detail: 'Fondateur', href: PROFILES.hartza },
  { label: 'AWS Partner Network', detail: 'Porté par le collectif', href: PROFILES.awsPartner },
] as const;
---

<section class="section section-alt" id="a-propos">
  <div class="container about">
    <div class="about-copy">
      <SectionHeading
        eyebrow="Qui je suis"
        title="Aurélien Perrier,"
        accent={`${years} ans d’infrastructure.`}
      />
      <p class="lede about-text">
        Je suis ingénieur cloud et DevOps, basé à {SITE.city}, indépendant depuis
        {independentYears} ans. Je commence ma carrière en 2016 chez Claranet, en
        alternance, sur des infrastructures AWS et GCP pour des clients comme
        Restos du Cœur, Dalkia et Qobuz. Je passe ensuite par Doctolib, puis
        Canal+, où je remplace les pipelines Jenkins par un système Kubernetes.
      </p>
      <p class="lede about-text">
        Depuis 2020, j’interviens sur des plateformes de grande taille : plus de
        800 microservices chez Seiitra, un parc de plus de 300 clusters
        Kubernetes chez SNCF. J’ai co-créé le collectif Cloud Partners et je
        co-organise le Meetup AWS Lyon. En parallèle, je développe et j’exploite
        Hartza Capital, une plateforme d’analyse de marchés financiers d’une
        centaine de microservices en Go.
      </p>
      <p class="lede about-text">
        Ce parcours m’a appris une chose simple : une plateforme se tient quand
        la personne qui l’a conçue sait aussi l’exploiter. C’est ce que je
        propose ici.
      </p>

      <div class="about-actions">
        <a class="btn btn-primary" href={SITE.emailHref}>Écrire un message</a>
        <a class="btn btn-ghost" href={SITE.cvPath} download>
          Télécharger le CV
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="about-side">
      <h3 class="side-title">Rattachements</h3>
      <ul class="credential-list">
        {
          credentials.map((credential) => (
            <li class="credential">
              <a class="credential-link" href={credential.href} target="_blank" rel="noopener">
                <span class="credential-label">{credential.label}</span>
                <span class="credential-detail">{credential.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h3 class="side-title side-title-spaced">Clients</h3>
      <ul class="client-names">
        {
          CLIENT_LOGOS.map((client) => (
            <li>{client.name}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .about-text {
    margin: 0;
    max-width: 68ch;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }

  .side-title {
    margin: 0 0 18px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .side-title-spaced {
    margin-top: 40px;
  }

  .credential-list,
  .client-names {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credential-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-hairline);
    transition: padding-left 0.2s ease;
  }

  .credential-link:hover {
    padding-left: 8px;
  }

  .credential-link:hover .credential-label {
    color: var(--color-cyan);
  }

  .credential-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ivory);
    transition: color 0.2s;
  }

  .credential-detail {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .client-names {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
  }

  .client-names li {
    padding: 5px 12px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
