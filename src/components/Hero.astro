---
/**
 * Home page hero section.
 *
 * Presents the value proposition, a portrait of the founder and the figures
 * backing the pitch, the two calls to action, and the client logo strip.
 * The opening paragraph answers "what do you do, and for whom" directly,
 * which is what answer engines extract before the rest of the page.
 *
 * The figures are computed from `CAREER` rather than typed in, so they cannot
 * go stale: a hand-written "9 years" becomes wrong the following year.
 *
 * Motion: elements carry `data-reveal` handled by the global reveal observer
 * wired in BaseLayout. Everything collapses to static under
 * `prefers-reduced-motion`.
 */
import type { Dictionary, Locale } from "@/i18n"

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary
  /** Current locale, used to resolve editorial content. */
  locale: Locale
}

const { t, locale } = Astro.props

const homeHref = locale === "fr" ? "/" : "/en/"
---

<section class="hero">
  <div class="circuit-grid" aria-hidden="true"></div>
  <div class="ambient-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>
        {t.hero.eyebrow}
      </p>
      <h1 class="text-display-xl hero-title" data-reveal data-reveal-delay="1">
        {t.hero.titleLead} <span class="accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="lede hero-lede" data-reveal data-reveal-delay="2">
        {t.hero.ledeLead}
        <br />
        <strong class="hero-modes">{t.hero.ledeModes}</strong>
        {", "}
        {t.hero.ledeReply}
      </p>

      <div class="hero-actions" data-reveal data-reveal-delay="3">
        <a class="btn btn-primary" href={`${homeHref}#contact`}>
          {t.hero.ctaPrimary}
        </a>
      </div>
    </div>

    <div class="hero-person" data-reveal data-reveal-delay="2">
      <figure class="portrait">
        <img
          src="/images/portrait.jpg"
          alt={t.hero.portraitAlt}
          width="800"
          height="800"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      <dl class="hero-stats" data-reveal data-reveal-delay="3">
        <div class="stat">
          <dt class="stat-value">+10</dt>
          <dd class="stat-label">{t.hero.statYearsLabel}</dd>
        </div>
        <div class="stat">
          <dt class="stat-value">+15</dt>
          <dd class="stat-label">{t.hero.statClientsLabel}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 0 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Very subtle circuit grid over the hero. Sits behind the ambient glow so
     the gradient still reads first; the pattern adds an engineering texture
     without competing with the type. Masks out toward the bottom of the hero
     so the logo strip stays clean. */
  .circuit-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("/images/circuit-grid.svg");
    background-size: 120px 120px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent 90%);
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 90%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    padding-bottom: 56px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .accent {
    background: linear-gradient(
      100deg,
      var(--color-violet) 0%,
      var(--color-azure) 45%,
      var(--color-cyan) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin: 0;
    max-width: 56ch;
  }

  /* The two engagement modes, pulled out of the muted lede colour: this is the
     line a buyer scanning the hero needs to catch. */
  .hero-modes {
    color: var(--color-ivory);
  }

  .hero-actions {
    margin-top: 12px;
  }

  /* Evidence figures under the portrait: two columns, big display number on
     top of its label, hairline between. Reads as two cards sharing the width
     of the portrait. */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    width: 100%;
    border-top: 1px solid var(--color-hairline);
  }

  .stat {
    padding: 22px 0 8px;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-hairline);
    padding-left: 22px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ivory);
  }

  .stat-label {
    margin: 8px 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .hero-person {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
    width: 100%;
    max-width: 340px;
    justify-self: end;
  }

  .portrait {
    margin: 0;
    width: 100%;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid var(--color-hairline);
    background-color: var(--color-surface);
  }

  .portrait-caption {
    display: flex;
    margin: 0;
  }

  .portrait-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  @media (max-width: 1000px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-person {
      max-width: 340px;
      margin-inline: auto;
      justify-self: center;
    }
  }
</style>
