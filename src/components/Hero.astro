---
/**
 * Section d'accroche de la page d'accueil.
 *
 * Présente la proposition de valeur, les preuves chiffrées et les deux appels
 * à l'action. Le premier paragraphe répond directement à la question
 * « que faites-vous et pour qui ? », ce que les moteurs de réponse extraient
 * avant le reste du contenu.
 */
import { totalYears, kubernetesYears } from '@/utils/career';
import { CLIENT_LOGOS } from '@/data/content';

const years = totalYears();
const k8sYears = kubernetesYears();

const stats = [
  { value: `${years}`, label: "ans d'expérience" },
  { value: `${k8sYears}`, label: 'ans sur Kubernetes' },
  { value: '300+', label: 'clusters opérés' },
] as const;
---

<section class="hero">
  <div class="ambient-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Freelance AWS &amp; Kubernetes · Lyon</p>
      <h1 class="text-display-xl hero-title">
        J’exploite et je fiabilise{' '}
        <span class="accent">votre plateforme cloud.</span>
      </h1>
      <p class="lede hero-lede">
        Audit d’architecture, gouvernance multi-comptes, plans FinOps. Exploitation de
        clusters EKS, supervision, incidents, mises à jour. Agents LLM et automatisation
        sur vos données métier. Conception et construction de services managés pour un
        cloud souverain.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/#contact">Parlons de votre projet</a>
        <a class="btn btn-ghost" href="/conseil/">
          Voir les prestations
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <dl class="hero-stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt class="stat-value">{stat.value}</dt>
            <dd class="stat-label">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="container logo-strip">
    <p class="logo-strip-label">Ils m’ont fait confiance</p>
    <ul class="logo-list">
      {
        CLIENT_LOGOS.map((client) => (
          <li class="logo-item">
            <img src={client.src} alt={client.name} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 72px 0 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-hairline);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    padding-bottom: 56px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .accent {
    background: linear-gradient(
      100deg,
      var(--color-violet) 0%,
      var(--color-azure) 45%,
      var(--color-cyan) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin: 0;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  /* Preuves chiffrées : filet supérieur, gros chiffre, libellé en dessous.
     Trois chiffres seulement, sur une colonne : la colonne latérale reste
     étroite et le hero garde la même hauteur que le titre. */
  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
  }

  .stat {
    border-top: 1px solid var(--color-hairline);
    padding-top: 18px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-cyan);
  }

  .stat-label {
    margin: 8px 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* Bandeau de logos clients */
  .logo-strip {
    position: relative;
    padding-block: 28px;
    border-top: 1px solid var(--color-hairline);
  }

  .logo-strip-label {
    margin: 0 0 18px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Rangée de logos : les sept marques se répartissent la largeur disponible à
     parts égales, chacune centrée dans sa colonne. La grille plutôt que le flex
     garantit que la rangée occupe toute la largeur même quand un logo est plus
     court que les autres. */
  .logo-list {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  /* Les logos sont des silhouettes blanches à des ratios très différents
     (de 1,9 à 5,9). On plafonne la hauteur et la largeur pour qu'aucune marque
     n'écrase les autres, en conservant leurs proportions. */
  .logo-item img {
    height: auto;
    width: auto;
    max-height: 26px;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.72;
    transition: opacity 0.25s;
  }

  .logo-item:hover img {
    opacity: 1;
  }

  @media (max-width: 1000px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    /* En dessous de sept colonnes, une grille laisserait la dernière ligne
       orpheline et alignée à gauche. Un flex centré répartit les logos
       restants au milieu, ce qui reste équilibré quel que soit leur nombre. */
    .logo-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 22px 28px;
    }

    .logo-item {
      flex: 0 1 auto;
    }
  }

  @media (max-width: 560px) {
    .logo-list {
      gap: 18px 24px;
    }

    .logo-item img {
      max-height: 21px;
    }

    .hero-stats {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
