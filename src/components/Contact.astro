---
/**
 * Contact section: direct channels and an embedded Calendly widget.
 *
 * The visitor books a 30-minute slot directly, without leaving the page.
 * The Calendly iframe is lazy-loaded so its third-party script does not
 * block the initial paint.
 */
import { SITE, PROFILES } from '@/consts';
import type { Dictionary, Locale } from '@/i18n';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale. The iframe title is localised through the dictionary. */
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<section class="section section-alt" id="contact">
  <div class="container contact-layout">
    <div class="contact-intro" data-reveal>
      <SectionHeading
        eyebrow={t.contact.eyebrow}
        title={t.contact.title}
        accent={t.contact.accent}
        lede={t.contact.lede}
      />

      <ul class="contact-channels">
        <li class="channel">
          <span class="channel-label">{t.contact.emailLabel}</span>
          <a class="channel-value" href={SITE.emailHref}>{SITE.email}</a>
        </li>
        <li class="channel">
          <span class="channel-label">{t.contact.locationLabel}</span>
          <span class="channel-value">{t.contact.location}</span>
        </li>
        <li class="channel">
          <span class="channel-label">{t.contact.linkedinLabel}</span>
          <a class="channel-value" href={PROFILES.linkedin} target="_blank" rel="noopener">
            {SITE.founder}
          </a>
        </li>
      </ul>
    </div>

    <div class="calendly-frame" data-reveal data-reveal-delay="1">
      <iframe
        src={`${SITE.calendly}?hide_gdpr_banner=1&background_color=05031a&text_color=eef2ff&primary_color=48b4f0`}
        title={t.contact.calendlyTitle}
        loading="lazy"
        class="calendly-iframe"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .channel:first-child {
    border-top: 1px solid var(--color-hairline);
  }

  .channel-label {
    min-width: 120px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .channel-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ivory);
  }

  a.channel-value {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Embedded Calendly: the widget needs room for the calendar, the slot list,
     and the booking form. 900px covers the full flow on desktop, the iframe's
     internal scroll handles the smaller viewports. */
  .calendly-frame {
    border: 1px solid var(--color-hairline);
    border-radius: 18px;
    background-color: var(--color-surface);
    overflow: hidden;
    height: 900px;
  }

  .calendly-iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
