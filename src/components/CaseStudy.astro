---
/**
 * Case study page: one engagement, told in three beats, closing on its stack.
 *
 * Three named sections rather than one block of prose: a reader skimming for
 * "what did they actually do" and an answer engine extracting a fragment both find
 * their answer in a heading. The layout is shared by both languages, so the French
 * and English pages cannot drift apart.
 */
import type { Dictionary, Locale } from '@/i18n';
import type { CaseStudy } from '@/data/case-studies';
import { getCaseStudies, casePath, caseHubPath } from '@/data/case-studies';
import { isParentCompanyStudy } from '@/data/case-studies/ownership';
import Contact from '@/components/Contact.astro';

interface Props {
  /** The engagement this page tells. */
  study: CaseStudy;
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale, used to resolve the other case studies and their links. */
  locale: Locale;
}

const { study, t, locale } = Astro.props;
const hub = getCaseStudies(locale);
const hubHref = caseHubPath(locale);

/** The other engagements, kept in the list so a reader lands on another case. */
const otherCases = hub.cases.filter((entry) => entry.id !== study.id);

const sections = [
  { heading: t.caseStudy.contextHeading, paragraphs: study.context },
  { heading: t.caseStudy.deliveredHeading, paragraphs: study.delivered },
  { heading: t.caseStudy.outcomeHeading, paragraphs: study.outcome },
];
---

<section class="section page-hero">
  <div class="ambient-glow" aria-hidden="true"></div>
  <div class="container">
    <p class="case-overline">
      <span class="case-client">{study.client}</span>
      <span class="case-client-type">{study.clientType}</span>
      <span class="case-period">{study.period}</span>
    </p>
    <h1 class="case-title text-display-xl">{study.title}</h1>
    <p class="lede case-lede">{study.summary}</p>
    {
      isParentCompanyStudy(study.id) && (
        <p class="case-notice">{t.parentStudy.notice}</p>
      )
    }
  </div>
</section>

<section class="section section-alt">
  <div class="container case-body">
    {
      sections.map((section) => (
        <article class="case-section">
          <h2 class="case-heading text-display-md">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="case-text">{paragraph}</p>
          ))}
        </article>
      ))
    }

    {study.misc && (
      <article class="case-section">
        <h2 class="case-heading text-display-md">{t.caseStudy.miscHeading}</h2>
        <ul class="check-list">
          {study.misc.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    )}

    <article class="case-section">
      <h2 class="case-heading text-display-md">{t.caseStudy.stackHeading}</h2>
      <ul class="tag-list">
        {study.stack.map((technology) => (
          <li class="tag">{technology}</li>
        ))}
      </ul>
    </article>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="case-heading text-display-md">{t.caseStudy.otherCasesHeading}</h2>
    <ul class="other-case-list">
      {
        otherCases.map((entry) => (
          <li class="other-case">
            <a class="other-case-link" href={casePath(entry.id, locale)}>
              <span class="other-case-client">{entry.client}</span>
              <span class="other-case-title">{entry.title}</span>
              <span class="other-case-period">{entry.period}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="case-back">
      <a class="btn btn-ghost btn-sm" href={hubHref}>
        {t.caseStudy.allCases}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<Contact t={t} locale={locale} />

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px);
  }

  .case-overline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    margin: 0 0 20px;
  }

  .case-client {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-violet);
  }

  .case-client-type,
  .case-period {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .case-notice {
    margin: 18px 0 0;
    padding: 12px 16px;
    border-left: 2px solid color-mix(in srgb, var(--color-cyan) 55%, transparent);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .case-title {
    margin: 0;
    max-width: 30ch;
    color: var(--color-ivory);
  }

  .case-lede {
    margin: 20px 0 0;
    max-width: 62ch;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 78ch;
  }

  .case-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .case-heading {
    margin: 0 0 4px;
    color: var(--color-ivory);
  }

  .case-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .other-case-list {
    display: flex;
    flex-direction: column;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .other-case {
    border-top: 1px solid var(--color-hairline);
  }

  .other-case:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .other-case-link {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) auto;
    gap: 6px 24px;
    align-items: baseline;
    padding: 16px 0;
    transition: color 0.2s;
  }

  .other-case-client {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-violet);
  }

  .other-case-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ivory);
  }

  .other-case-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .other-case-link:hover .other-case-title {
    color: var(--color-cyan);
  }

  .case-back {
    margin: 32px 0 0;
  }

  @media (max-width: 800px) {
    .other-case-link {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
