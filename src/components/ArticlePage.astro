---
/**
 * Article body: metadata, table of contents and the rendered Markdown.
 *
 * The rendered content arrives through a slot, because rendering a collection
 * entry is the calling page's job. Everything else — breadcrumb, heading, table
 * of contents, footer — is language-dependent only through the dictionary, so
 * the French and English article pages share this layout.
 */
import type { Dictionary, Locale } from '@/i18n';
import { SITE } from '@/consts';
import { formatDate } from '@/utils/blog';

interface Heading {
  /** Heading level, 2 or 3. */
  depth: number;
  /** Anchor target of the heading. */
  slug: string;
  /** Heading text. */
  text: string;
}

interface Props {
  /** Article title. */
  title: string;
  /** One-sentence summary shown under the title. */
  summary?: string;
  /** Topics covered, shown as tags. */
  tags: readonly string[];
  /** Publication date. */
  publishedAt: Date;
  /** Last revision date, when the article was updated. */
  updatedAt?: Date;
  /** Headings collected by the Markdown renderer, for the table of contents. */
  headings: readonly Heading[];
  /** Reading time in minutes. */
  minutes: number;
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale, used for dates and links. */
  locale: Locale;
}

const {
  title,
  summary,
  tags,
  publishedAt,
  updatedAt,
  headings,
  minutes,
  t,
  locale,
} = Astro.props;

const homeHref = locale === 'fr' ? '/' : '/en/';
const blogHref = locale === 'fr' ? '/blog/' : '/en/blog/';
const contactHref = `${homeHref}#contact`;

/** Level 2 and 3 headings, for the side table of contents. */
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<article class="section article">
  <div class="ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <nav class="breadcrumb" aria-label={t.common.onThisPage}>
      <ol>
        <li><a href={homeHref}>{t.notFound.entries[0]?.label ?? 'Home'}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={blogHref}>{t.blog.breadcrumb}</a></li>
      </ol>
    </nav>

    <header class="article-head">
      <p class="article-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, locale)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {t.common.readingTimeSuffix}</span>
        <span aria-hidden="true">·</span>
        <span>{t.common.byAuthor} {SITE.founder}</span>
      </p>

      <h1 class="text-display-lg article-title">{title}</h1>

      {summary && <p class="lede article-summary">{summary}</p>}

      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="article-layout">
      <div class="article-body">
        <slot />

        {
          updatedAt && (
            <p class="article-updated">
              {t.common.updatedOn} {formatDate(updatedAt, locale)}.
            </p>
          )
        }
      </div>

      {
        toc.length > 0 && (
          <aside class="article-toc">
            <h2 class="toc-title" id="toc-heading">{t.common.onThisPage}</h2>
            <nav aria-labelledby="toc-heading">
              <ul>
                {toc.map((heading) => (
                  <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="article-foot">
      <p class="article-foot-text">
        {t.blog.articleFootLead}{' '}
        <a href={contactHref}>{t.blog.articleFootCta}</a>
      </p>
      <a class="btn btn-ghost btn-sm" href={blogHref}>
        <span aria-hidden="true">←</span>
        {t.common.allArticles}
      </a>
    </footer>
  </div>
</article>

<style>
  .article {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 6vw, 72px) clamp(64px, 8vw, 96px);
  }

  .breadcrumb {
    position: relative;
    margin-bottom: 30px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb a:hover {
    color: var(--color-cyan);
  }

  .article-head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 78ch;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .article-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .article-summary {
    margin: 0;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
    margin-top: 48px;
  }

  .article-body {
    min-width: 0;
  }

  /* Markdown content styling. The styles are global because the HTML comes from
     the Markdown renderer, outside the reach of scoped styles. */
  .article-body :global(h2) {
    margin: 48px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    text-wrap: balance;
  }

  .article-body :global(h3) {
    margin: 36px 0 12px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ivory);
  }

  .article-body :global(p) {
    margin: 0 0 20px;
    max-width: 74ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .article-body :global(p:first-of-type) {
    font-size: 1.1875rem;
    color: var(--color-ivory);
  }

  .article-body :global(strong) {
    color: var(--color-ivory);
    font-weight: 600;
  }

  .article-body :global(a) {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 22px;
    max-width: 74ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .article-body :global(li) {
    margin-bottom: 10px;
  }

  .article-body :global(li::marker) {
    color: var(--color-cyan);
  }

  .article-body :global(code) {
    padding: 2px 6px;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    background-color: var(--color-ink-deep);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.875em;
    color: var(--color-cyan);
  }

  .article-body :global(pre) {
    margin: 0 0 24px;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    background-color: var(--color-ink-deep);
  }

  .article-body :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ivory);
  }

  .article-body :global(blockquote) {
    margin: 0 0 24px;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--color-cyan);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ivory);
  }

  .article-body :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .article-updated {
    margin: 32px 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* Table of contents: sticky, hidden when the article has no headings */
  .article-toc {
    position: sticky;
    top: 96px;
    padding-left: 24px;
    border-left: 1px solid var(--color-hairline);
  }

  .toc-title {
    margin: 0 0 14px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .article-toc ul {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item a {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: var(--color-cyan);
  }

  .toc-depth-3 {
    padding-left: 14px;
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--color-hairline);
  }

  .article-foot-text {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .article-foot-text a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .article-toc {
      position: static;
      order: -1;
      padding-left: 0;
      padding-bottom: 20px;
      border-left: 0;
      border-bottom: 1px solid var(--color-hairline);
    }
  }
</style>
