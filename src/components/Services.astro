---
/**
 * Services grid: consulting, managed services and the two related offerings.
 *
 * A card links to its dedicated page when one exists. An offering carried only
 * by the home page renders without a link rather than pointing at a missing
 * page.
 */
import { getContent } from '@/data';
import type { Dictionary, Locale } from '@/i18n';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale, used to resolve editorial content. */
  locale: Locale;
}

const { t, locale } = Astro.props;
const { SERVICES } = getContent(locale);
---

<section class="section" id="prestations">
  <div class="container">
    <SectionHeading
      eyebrow={t.services.eyebrow}
      title={t.services.title}
      accent={t.services.accent}
    />
    <p class="services-lede lede">{t.services.lede}</p>

    <ul class="service-grid">
      {
        SERVICES.map((service, index) => (
          <li class="card service-card" data-reveal data-reveal-delay={String(index % 4)}>
            <h3 class="card-title text-display-sm">{service.title}</h3>
            <p class="card-text">{service.summary}</p>
            <ul class="check-list">
              {service.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .services-lede {
    margin: 4px 0 0;
    max-width: 62ch;
  }

  .service-card {
    /* Progressive vertical offset, the grid's visual signature */
    transform: translateY(calc(var(--card-offset, 0) * 1px));
  }

  .service-card:nth-child(2) {
    --card-offset: 22;
  }

  .service-card:nth-child(4) {
    --card-offset: 22;
  }

  @media (max-width: 900px) {
    .service-card {
      transform: none;
    }
  }
</style>
