---
/**
 * Services grid: consulting, managed services and the two related offerings.
 *
 * A card links to its dedicated page when one exists. An offering carried only
 * by the home page renders without a link rather than pointing at a missing
 * page.
 */
import { getContent } from "@/data"
import type { Dictionary, Locale } from "@/i18n"
import { findRoutePair } from "@/i18n/routes"
import SectionHeading from "@/components/SectionHeading.astro"

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary
  /** Current locale, used to resolve editorial content. */
  locale: Locale
}

const { t, locale } = Astro.props
const { SERVICES } = getContent(locale)

/**
 * Path of the page carrying a service, in the current language.
 *
 * @param serviceSlug URL segment the service shares with its pillar page, such as `conseil`
 * @returns The page path, or `null` when no page carries that service
 */
function servicePagePath(serviceSlug: string): string | null {
  const path = locale === "fr" ? `/${serviceSlug}/` : `/en/${serviceSlug}/`
  return findRoutePair(path) ? path : null
}
---

<section class="section" id="prestations">
  <div class="container">
    <SectionHeading
      eyebrow={t.services.eyebrow}
      title={t.services.title}
      accent={t.services.accent}
    />
    <p class="services-lede lede">{t.services.lede}</p>

    <ul class="service-grid">
      {SERVICES.map((service, index) => {
        const pagePath = servicePagePath(service.slug)
        return (
          <li
            class="card service-card"
            data-reveal
            data-reveal-delay={String(index % 4)}
          >
            <h3 class="card-title text-display-sm">
              {pagePath ? (
                <a class="service-link" href={pagePath}>
                  {service.title}
                  <span class="service-link-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ) : (
                service.title
              )}
            </h3>
            <p class="card-text">{service.summary}</p>
            <ul class="check-list">
              {service.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        )
      })}
    </ul>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .services-lede {
    margin: 4px 0 0;
    max-width: 62ch;
  }

  .service-card {
    position: relative;
    /* Progressive vertical offset, the grid's visual signature */
    transform: translateY(calc(var(--card-offset, 0) * 1px));
  }

  .service-link {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is the target, the title stays the accessible link text */
  .service-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .service-link-arrow {
    display: inline-block;
    margin-left: 8px;
    color: var(--color-cyan);
    transition: transform 0.18s ease;
  }

  .service-card:hover .service-link-arrow {
    transform: translateX(3px);
  }

  .service-card:nth-child(2) {
    --card-offset: 22;
  }

  .service-card:nth-child(4) {
    --card-offset: 22;
  }

  @media (max-width: 900px) {
    .service-card {
      transform: none;
    }
  }
</style>
