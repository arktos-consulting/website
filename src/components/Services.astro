---
/**
 * Grille des prestations : conseil, infogérance et les deux offres associées.
 *
 * Les cartes mènent vers les pages piliers dédiées quand elles existent, de
 * sorte que la page d'accueil oriente vers les pages qui portent les requêtes
 * commerciales.
 */
import { SERVICES } from '@/data/content';
import SectionHeading from '@/components/SectionHeading.astro';
---

<section class="section" id="prestations">
  <div class="container">
    <SectionHeading
      eyebrow="Prestations"
      title="Ce que je prends"
      accent="en charge."
    />
    <p class="services-lede lede">
      Quatre domaines, tenus par la même personne — de l’audit à l’exploitation.
      Chaque mission est cadrée avant d’être facturée.
    </p>

    <ul class="service-grid">
      {
        SERVICES.map((service) => (
          <li class="card service-card">
            <h3 class="card-title text-display-sm">{service.title}</h3>
            <p class="card-text">{service.summary}</p>
            <ul class="check-list">
              {service.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {service.href && (
              <a class="service-link" href={service.href}>
                En savoir plus
                <span aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .services-lede {
    margin: 4px 0 0;
    max-width: 62ch;
  }

  .service-card {
    /* Décalage vertical progressif, signature visuelle de la grille */
    transform: translateY(calc(var(--card-offset, 0) * 1px));
  }

  .service-card:nth-child(2) {
    --card-offset: 22;
  }

  .service-card:nth-child(4) {
    --card-offset: 22;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-violet);
    transition: gap 0.2s ease;
  }

  .service-link:hover {
    gap: 14px;
  }

  @media (max-width: 900px) {
    .service-card {
      transform: none;
    }
  }
</style>
