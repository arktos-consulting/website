---
/**
 * Arguments de réassurance, en réponse aux travers habituels des sociétés de
 * services : intermédiaires, périmètres flous, missions qui s'éternisent.
 *
 * Les intitulés sont visibles et les explications tiennent en une ligne : un
 * argument de vente se lit, il ne se démontre pas.
 */
import { DIFFERENTIATORS } from '@/data/content';
import SectionHeading from '@/components/SectionHeading.astro';
---

<section class="section section-alt" id="pourquoi">
  <div class="container">
    <SectionHeading
      eyebrow="Pourquoi travailler avec moi"
      title="Un interlocuteur unique,"
      accent="du cadrage à la production."
    />

    <ul class="reason-grid">
      {
        DIFFERENTIATORS.map((reason) => (
          <li class="reason">
            <h3 class="reason-title">{reason.title}</h3>
            <p class="reason-body">{reason.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reason-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 36px 48px;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .reason {
    border-top: 1px solid var(--color-hairline);
    padding-top: 20px;
  }

  .reason-title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ivory);
    text-wrap: balance;
  }

  .reason-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
