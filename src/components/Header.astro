---
/**
 * Fixed header: logo, main navigation, language switch and call to action.
 *
 * The mobile menu is driven by a hidden checkbox rather than JavaScript, so it
 * stays usable without scripting and adds no hydration cost to an otherwise
 * static page.
 *
 * The language switch links to the equivalent page in the other locale. That URL
 * is passed in from the page, because URL segments are translated rather than
 * prefixed (`/cloud-souverain/` in French, `/en/sovereign-cloud/` in English):
 * only the page itself knows its counterpart.
 */
import { SITE } from '@/consts';
import type { Dictionary, Locale } from '@/i18n';
import { alternateLocale, LANGUAGE_LABELS } from '@/i18n';

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale, used to label the language switch. */
  locale: Locale;
  /** URL of this page in the other locale, or `null` when there is no translation. */
  alternateUrl: string | null;
}

const { t, locale, alternateUrl } = Astro.props;
const otherLocale = alternateLocale(locale);
const homeHref = locale === 'fr' ? '/' : '/en/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={`${SITE.name}, ${t.nav.home}`}>
      <img
        src="/images/logo.svg"
        alt=""
        width="52"
        height="39"
        class="brand-mark"
        loading="eager"
        decoding="async"
      />
      <span class="brand-text">
        <span class="brand-name">Arktos</span>
        <span class="brand-sub">{t.common.brandSub}</span>
      </span>
    </a>

    <input
      type="checkbox"
      id="nav-toggle"
      class="nav-toggle visually-hidden"
      aria-label={t.nav.openMenu}
    />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="site-nav" aria-label={t.nav.mainNavigation}>
      <ul class="nav-list">
        {
          t.nav.links.map((link) => (
            <li>
              <a class="nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        alternateUrl && (
          <a
            class="lang-switch"
            href={alternateUrl}
            hreflang={otherLocale}
            lang={otherLocale}
            aria-label={t.nav.languageSwitch}
          >
            {LANGUAGE_LABELS[otherLocale]}
          </a>
        )
      }

      <a class="btn btn-primary nav-cta" href={`${homeHref}#contact`}>
        {t.nav.cta}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 72px;
    display: flex;
    align-items: center;
    background-color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 52px;
    height: auto;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-ivory);
    background-color: var(--color-surface-raised);
  }

  /* Language switch: compact, and set apart from the navigation links so it is
     not mistaken for a section of the site. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    margin-left: 10px;
    padding: 9px 12px;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .lang-switch:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .nav-cta {
    margin-left: 12px;
  }

  /* Mobile menu: opened by the checkbox, no script involved */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
  }

  .nav-burger span {
    display: block;
    height: 2px;
    width: 100%;
    background-color: var(--color-ivory);
    border-radius: 1px;
    transition: transform 0.25s ease;
  }

  .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle:checked ~ .nav-burger span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-toggle:focus-visible ~ .nav-burger {
    outline: 3px solid var(--color-cyan);
    outline-offset: 2px;
  }

  @media (max-width: 1000px) {
    .nav-burger {
      display: flex;
    }

    .site-nav {
      position: fixed;
      inset: 72px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 16px var(--spacing-gutter) 28px;
      background-color: var(--color-ink-deep);
      border-bottom: 1px solid var(--color-hairline);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .nav-toggle:checked ~ .site-nav {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .nav-link {
      padding: 14px 12px;
      font-size: 1rem;
    }

    .lang-switch {
      align-self: flex-start;
      margin: 12px 0 0;
    }

    .nav-cta {
      margin: 12px 0 0;
      justify-content: center;
    }
  }
</style>
