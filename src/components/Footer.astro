---
/**
 * Pied de page : navigation secondaire, coordonnées et informations légales.
 *
 * Les mentions d'identité (SIRET, forme juridique) sont reprises de la source
 * unique du site, afin qu'elles restent identiques aux données structurées et
 * aux registres publics.
 */
import { SITE, PROFILES, NAV_LINKS } from '@/consts';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-columns">
      <div class="footer-brand">
        <img
          src="/images/logo.svg"
          alt={SITE.name}
          width="56"
          height="42"
          loading="lazy"
          decoding="async"
        />
        <p class="footer-tagline">
          Conseil et infogérance AWS &amp; Kubernetes pour des plateformes qui
          doivent tenir en production.
        </p>
        <ul class="footer-socials">
          <li>
            <a href={PROFILES.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </li>
          <li>
            <a href={PROFILES.github} target="_blank" rel="noopener">GitHub</a>
          </li>
          <li>
            <a href={SITE.cvPath} download>CV</a>
          </li>
        </ul>
      </div>

      <nav class="footer-column" aria-labelledby="footer-nav">
        <h2 class="footer-heading" id="footer-nav">Prestations</h2>
        <ul class="footer-links">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          <li>
            <a href="/blog/rss.xml">Flux RSS</a>
          </li>
        </ul>
      </nav>

      <nav class="footer-column" aria-labelledby="footer-ecosystem">
        <h2 class="footer-heading" id="footer-ecosystem">Écosystème</h2>
        <ul class="footer-links">
          <li>
            <a href={PROFILES.cloudPartners} target="_blank" rel="noopener">Cloud Partners</a>
          </li>
          <li>
            <a href={PROFILES.meetup} target="_blank" rel="noopener">Meetup AWS Lyon</a>
          </li>
          <li>
            <a href={PROFILES.hartza} target="_blank" rel="noopener">Hartza Capital</a>
          </li>
        </ul>
      </nav>

      <div class="footer-column">
        <h2 class="footer-heading">Contact</h2>
        <ul class="footer-links">
          <li>
            <a href={SITE.emailHref}>{SITE.email}</a>
          </li>
          <li>{SITE.city}, France</li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <p>
        &copy; {new Date().getFullYear()} {SITE.name} · {SITE.legalForm} au capital de{' '}
        {SITE.shareCapital} · SIRET {SITE.siret}
      </p>
      <ul class="footer-legal-links">
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href={SITE.registryUrl} target="_blank" rel="noopener">Fiche entreprise</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-ink-deep);
    border-top: 1px solid var(--color-hairline);
    padding-block: 64px 32px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 340px;
  }

  .footer-tagline {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .footer-socials {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-socials a,
  .footer-links a {
    font-size: 0.9375rem;
    color: var(--color-muted);
    transition: color 0.2s;
  }

  .footer-socials a {
    color: var(--color-cyan);
  }

  .footer-socials a:hover,
  .footer-links a:hover {
    color: var(--color-cyan);
  }

  .footer-heading {
    margin: 0 0 16px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 26px;
    border-top: 1px solid var(--color-hairline);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .footer-legal p {
    margin: 0;
  }

  .footer-legal-links {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-legal-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-legal-links a:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 1000px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }
  }

  @media (max-width: 560px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }

    .footer-legal {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
