---
/**
 * References page body: every published engagement.
 *
 * Each engagement describes the context, the constraint and the technologies
 * involved. It is the technical detail that constitutes the proof, more than the
 * client's name. Shared by the French and English routes.
 */
import type { Dictionary, Locale } from '@/i18n';
import { getContent } from '@/data';
import SectionHeading from '@/components/SectionHeading.astro';
import Contact from '@/components/Contact.astro';

interface Props {
  /** Dictionary for the current locale. */
  t: Dictionary;
  /** Current locale, used to resolve editorial content. */
  locale: Locale;
}

const { t, locale } = Astro.props;
const { MISSIONS } = getContent(locale);
---

<section class="section page-hero">
  <div class="ambient-glow" aria-hidden="true"></div>
  <div class="container">
    <SectionHeading
      eyebrow={t.references.eyebrow}
      level="h1"
      title={t.references.heroTitle}
      accent={t.references.heroAccent}
      lede={`${MISSIONS.length} ${t.references.heroLedeLead}`}
    />
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <ol class="mission-list">
      {
        MISSIONS.map((mission) => (
          <li class="mission">
            <div class="mission-meta">
              <p class="mission-client">{mission.client ?? mission.clientType}</p>
              <p class="mission-period">{mission.period}</p>
            </div>
            <div class="mission-body">
              <h2 class="mission-title text-display-md">{mission.title}</h2>
              <p class="mission-text">{mission.description}</p>
              <ul class="tag-list">
                {mission.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mission-footnote">{t.references.footnote}</p>
  </div>
</section>

<Contact t={t} locale={locale} />

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px);
  }

  .mission-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mission {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    padding: 36px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .mission:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .mission-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mission-client {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-violet);
  }

  .mission-period {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .mission-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mission-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .mission-text {
    margin: 0;
    max-width: 78ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .mission-footnote {
    margin: 40px 0 0;
    max-width: 78ch;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .mission {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
