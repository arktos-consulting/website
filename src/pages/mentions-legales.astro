---
/**
 * Mentions légales et information sur les données personnelles.
 *
 * Page utilitaire : elle est exclue du plan du site et de l'indexation, tout en
 * restant accessible depuis le pied de page.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/consts';

const description =
  'Mentions légales et informations sur les données personnelles du site Arktos Consulting.';
---

<BaseLayout title="Mentions légales" description={description} noindex>
  <section class="section page-hero">
    <div class="container">
      <h1 class="text-display-lg">Mentions légales</h1>
      <p class="lede hero-lede">
        Informations légales relatives à l’éditeur du site et au traitement des
        données personnelles.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container legal">
      <article>
        <h2 class="legal-title">Éditeur du site</h2>
        <dl class="legal-list">
          <div>
            <dt>Dénomination</dt>
            <dd>{SITE.legalName}</dd>
          </div>
          <div>
            <dt>Forme juridique</dt>
            <dd>{SITE.legalForm} au capital de {SITE.shareCapital}</dd>
          </div>
          <div>
            <dt>SIRET</dt>
            <dd>{SITE.siret}</dd>
          </div>
          <div>
            <dt>Siège</dt>
            <dd>{SITE.city}, {SITE.region}, France</dd>
          </div>
          <div>
            <dt>Contact</dt>
            <dd><a href={SITE.emailHref}>{SITE.email}</a></dd>
          </div>
        </dl>
        <p class="legal-text">
          Informations vérifiables sur l’annuaire des entreprises :
          <a href={SITE.registryUrl} target="_blank" rel="noopener">fiche Arktos Consulting</a>.
        </p>
      </article>

      <article>
        <h2 class="legal-title">Hébergement</h2>
        <p class="legal-text">
          Le site est hébergé par GitHub Pages (GitHub, Inc., 88 Colin P. Kelly Jr.
          Street, San Francisco, CA 94107, États-Unis) et distribué via le réseau
          Cloudflare.
        </p>
      </article>

      <article>
        <h2 class="legal-title">Données personnelles</h2>
        <p class="legal-text">
          Ce site ne dépose aucun cookie de mesure d’audience ni de suivi
          publicitaire, et n’utilise aucun outil d’analyse tiers.
        </p>
        <p class="legal-text">
          Le formulaire de contact ne transmet aucune donnée à un serveur : il
          compose un brouillon de message dans votre propre logiciel de
          messagerie, que vous relisez et envoyez vous-même. Les informations que
          vous choisissez d’envoyer par e-mail ou par LinkedIn sont traitées dans
          le seul but de répondre à votre demande, et conservées le temps
          nécessaire à cet échange.
        </p>
        <p class="legal-text">
          Conformément au Règlement général sur la protection des données, vous
          disposez d’un droit d’accès, de rectification et d’effacement des
          données vous concernant. Pour l’exercer, écrivez à
          <a href={SITE.emailHref}>{SITE.email}</a>.
        </p>
      </article>

      <article>
        <h2 class="legal-title">Propriété intellectuelle</h2>
        <p class="legal-text">
          Les contenus de ce site, textes et éléments graphiques, sont la
          propriété d’{SITE.legalName}, sauf mention contraire. Les marques et
          logos de clients cités appartiennent à leurs titulaires respectifs et
          sont reproduits à titre de référence.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(72px, 9vw, 128px) clamp(40px, 5vw, 64px);
  }

  .hero-lede {
    margin: 16px 0 0;
    max-width: 62ch;
  }

  .legal {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 78ch;
  }

  .legal-title {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .legal-text {
    margin: 0 0 14px;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .legal-text:last-child {
    margin-bottom: 0;
  }

  .legal-text a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-list {
    display: grid;
    gap: 14px;
    margin: 0 0 20px;
  }

  .legal-list div {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .legal-list dt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .legal-list dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ivory);
  }

  .legal-list a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .legal-list div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
