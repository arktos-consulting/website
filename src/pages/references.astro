---
/**
 * Page « Références » : l'ensemble des missions publiées.
 *
 * Chaque mission décrit le contexte, la contrainte et les technologies
 * mobilisées. C'est le détail technique qui constitue la preuve, davantage que
 * le nom du client.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Contact from '@/components/Contact.astro';
import { SITE } from '@/consts';
import { MISSIONS } from '@/data/content';
import { buildBreadcrumbs, serializeJsonLd } from '@/utils/seo';

const description = `${MISSIONS.length} missions d'infrastructure AWS, Kubernetes et DevOps : Bpifrance, SNCF, Yseop, Seiitra, Doctolib, Canal+. Détail technique de chaque intervention.`;

const breadcrumbs = buildBreadcrumbs([
  { name: 'Accueil', url: `${SITE.url}/` },
  { name: 'Références', url: `${SITE.url}/references/` },
]);
---

<BaseLayout
  title="Références — missions AWS & Kubernetes"
  description={description}
  canonical={`${SITE.url}/references/`}
>
  {
    breadcrumbs && (
      <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)} />
    )
  }

  <section class="section page-hero">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="container">
      <SectionHeading
        eyebrow="Références"
        level="h1"
        title="Le détail technique"
        accent="plutôt que les logos."
        lede={`${MISSIONS.length} missions, de l’opérateur ferroviaire national à une plateforme de santé, en passant par un éditeur SaaS et ma propre plateforme d’analyse financière. Pour chaque mission : le contexte, la contrainte et ce qui a été livré.`}
      />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <ol class="mission-list">
        {
          MISSIONS.map((mission) => (
            <li class="mission">
              <div class="mission-meta">
                <p class="mission-client">
                  {mission.client ?? mission.clientType}
                </p>
                <p class="mission-period">{mission.period}</p>
              </div>
              <div class="mission-body">
                <h2 class="mission-title text-display-md">{mission.title}</h2>
                <p class="mission-text">{mission.description}</p>
                <ul class="tag-list">
                  {mission.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="mission-footnote">
        Les missions longues sont nommées avec l’accord des clients concernés. Pour
        toute mission couverte par une clause de confidentialité, le contenu
        technique peut être détaillé en entretien sous accord mutuel.
      </p>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px);
  }

  .mission-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mission {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    padding: 36px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .mission:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .mission-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mission-client {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-violet);
  }

  .mission-period {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .mission-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mission-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .mission-text {
    margin: 0;
    max-width: 78ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .mission-footnote {
    margin: 40px 0 0;
    max-width: 78ch;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .mission {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
