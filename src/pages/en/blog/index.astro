---
/**
 * Blog listing, English route.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogIndex from '@/components/BlogIndex.astro';
import { getDictionary } from '@/i18n';

const locale = 'en' as const;
const t = getDictionary(locale);

const description =
  'Technical notes on AWS, Kubernetes and running platforms: FinOps, managed services, compliance. What the field teaches, published when there is something specific to say.';
---

<BaseLayout
  title={t.blog.title}
  description={description}
>
  <BlogIndex t={t} locale={locale} />
</BaseLayout>
