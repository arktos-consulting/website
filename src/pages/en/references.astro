---
/**
 * References page, English route.
 *
 * URL segment is kept identical to the French one ("references" reads the same in
 * both languages) but the path is still declared explicitly, so the pair stays
 * verifiable in one place.
 */
import BaseLayout from "@/layouts/BaseLayout.astro"
import ReferencesPage from "@/components/ReferencesPage.astro"
import { getDictionary } from "@/i18n"
import { getCaseStudies } from "@/data/case-studies"
import { missionClientNames } from "@/data"
import { buildBreadcrumbs, serializeJsonLd } from "@/utils/seo"
import { SITE } from "@/consts"

const locale = "en" as const
const t = getDictionary(locale)
const { cases } = getCaseStudies(locale)

const description = `${cases.length} AWS, Kubernetes and DevOps infrastructure engagements: ${missionClientNames(locale).join(", ")}.`

const breadcrumbs = buildBreadcrumbs([
  { name: "Home", url: `${SITE.url}/en/` },
  { name: "References", url: `${SITE.url}${Astro.url.pathname}` },
])
---

<BaseLayout title={t.references.pageTitle} description={description}>
  {breadcrumbs && (
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(breadcrumbs)}
    />
  )}
  <ReferencesPage t={t} locale={locale} />
</BaseLayout>
