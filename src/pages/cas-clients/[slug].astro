---
/**
 * Case study page, French route.
 *
 * Pre-rendered as complete HTML: the engagement is fully readable by a crawler or
 * an answer engine without running a script. The page title and description come
 * from the same content object as the visible text, so the two cannot disagree.
 */
import type { GetStaticPaths } from "astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import CaseStudy from "@/components/CaseStudy.astro"
import { SITE } from "@/consts"
import { getDictionary } from "@/i18n"
import { getCaseStudies, casePath } from "@/data/case-studies"
import { buildBreadcrumbs, serializeJsonLd } from "@/utils/seo"

export const getStaticPaths = (() => {
  const hub = getCaseStudies("fr")
  return hub.cases.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }))
}) satisfies GetStaticPaths

const locale = "fr" as const
const t = getDictionary(locale)
const hub = getCaseStudies(locale)
const { study } = Astro.props

const pageUrl = `${SITE.url}${casePath(study.id, locale)}`

const breadcrumbs = buildBreadcrumbs([
  { name: "Accueil", url: `${SITE.url}/` },
  { name: hub.breadcrumb, url: `${SITE.url}/cas-clients/` },
  { name: study.client, url: pageUrl },
])

/**
 * Case study structured data.
 *
 * A `CreativeWork` tied to the client and to the site's organisation entity: that
 * is what lets an answer engine cite the engagement while naming the client and
 * the stack, rather than reusing the text without attribution.
 */
const caseSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${pageUrl}#case-study`,
  name: study.title,
  description: study.summary,
  url: pageUrl,
  inLanguage: locale,
  about: { "@type": "Organization", name: study.client },
  ...(study.stack.length > 0 && { keywords: study.stack.join(", ") }),
  author: {
    "@type": "Person",
    name: SITE.founder,
    jobTitle: SITE.founderJobTitle,
    url: `${SITE.url}/`,
  },
  publisher: { "@id": `${SITE.url}/#organization` },
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntityOfPage: pageUrl,
}
---

<BaseLayout title={study.title} description={study.summary}>
  <script type="application/ld+json" set:html={serializeJsonLd(caseSchema)} />
  {breadcrumbs && (
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(breadcrumbs)}
    />
  )}
  <CaseStudy study={study} t={t} locale={locale} />
</BaseLayout>
