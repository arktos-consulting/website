---
/**
 * Applied AI pillar page, French route.
 *
 * The page body lives in a shared component rendered from content, so the French
 * and English versions share one layout. This file only declares which content
 * to load and which URLs the page answers on.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppliedAi from '@/components/pillars/AppliedAi.astro';
import { getPillars } from '@/data/pillars';
import { getDictionary } from '@/i18n';
import { buildBreadcrumbs, serializeJsonLd } from '@/utils/seo';

const locale = 'fr' as const;
const pillar = getPillars(locale).ai;
const t = getDictionary(locale);

const breadcrumbs = buildBreadcrumbs([
  { name: 'Accueil', url: `${Astro.site}/` },
  { name: pillar.breadcrumb, url: `${Astro.site}${Astro.url.pathname}` },
]);
---

<BaseLayout title={pillar.title} description={pillar.description}>
  {
    breadcrumbs && (
      <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)} />
    )
  }
  <AppliedAi pillar={pillar} t={t} locale={locale} />
</BaseLayout>
