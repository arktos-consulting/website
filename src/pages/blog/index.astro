---
/**
 * Listing du blog.
 *
 * Les articles sont lus depuis la collection `blog` : ajouter un fichier
 * Markdown suffit à le publier. Le flux RSS est proposé en lien pour les
 * lecteurs qui suivent le site sans revenir le consulter.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import Contact from '@/components/Contact.astro';
import { SITE } from '@/consts';
import { getPublishedPosts } from '@/utils/blog';

const posts = await getPublishedPosts();

const description =
  "Notes techniques sur AWS, Kubernetes et l'exploitation de plateformes : FinOps, infogérance, conformité. Ce que le terrain apprend, publié quand il y a quelque chose de précis à dire.";
---

<BaseLayout
  title="Blog — notes d'architecture AWS"
  description={description}
  canonical={`${SITE.url}/blog/`}
>
  <section class="section page-hero">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="container">
      <SectionHeading
        eyebrow="Blog"
        level="h1"
        title="Ce que le terrain"
        accent="apprend."
        lede="Notes sur l'architecture AWS, Kubernetes et l'exploitation de plateformes. Publié quand il y a quelque chose de précis à dire, jamais pour tenir un rythme."
      />

      <div class="blog-actions">
        <a class="btn btn-ghost btn-sm" href="/blog/rss.xml">
          Flux RSS
          <span aria-hidden="true">→</span>
        </a>
        <span class="blog-count">
          {posts.length} article{posts.length > 1 ? 's' : ''}
        </span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </ul>
        ) : (
          <p class="empty-state">
            Aucun article publié pour le moment. Le premier arrive bientôt —
            <a href="/#contact">écrivez-moi</a> si un sujet vous intéresse.
          </p>
        )
      }
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px) clamp(32px, 4vw, 48px);
  }

  .blog-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .blog-count {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: 1px solid var(--color-hairline);
  }

  .empty-state {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .empty-state a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
