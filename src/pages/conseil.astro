---
/**
 * Consulting pillar page, French route.
 *
 * The page body lives in a shared component rendered from content, so the French
 * and English versions share one layout. This file declares only which content to
 * load: the layout resolves the canonical URL, the `hreflang` alternates and the
 * language switch from the request path and the shared translation table.
 */
import BaseLayout from "@/layouts/BaseLayout.astro"
import Consulting from "@/components/pillars/Consulting.astro"
import { getPillars } from "@/data/pillars"
import { getDictionary } from "@/i18n"
import { buildBreadcrumbs, serializeJsonLd } from "@/utils/seo"
import { SITE } from "@/consts"

const locale = "fr" as const
const pillar = getPillars(locale).consulting
const t = getDictionary(locale)

const breadcrumbs = buildBreadcrumbs([
  { name: "Accueil", url: `${SITE.url}/` },
  { name: pillar.breadcrumb, url: `${SITE.url}${Astro.url.pathname}` },
])
---

<BaseLayout
  title={pillar.metaTitle ?? pillar.title}
  description={pillar.description}
>
  {breadcrumbs && (
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(breadcrumbs)}
    />
  )}
  <Consulting pillar={pillar} t={t} locale={locale} />
</BaseLayout>
