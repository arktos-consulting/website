---
/**
 * Page pilier « Conseil ».
 *
 * Elle répond aux requêtes commerciales du conseil cloud : audit, architecture,
 * gouvernance, FinOps. La structure est volontairement factuelle et directe,
 * chaque section commençant par la réponse avant de la détailler.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Contact from '@/components/Contact.astro';
import { SITE, PROFILES } from '@/consts';
import { totalYears } from '@/utils/career';
import { buildBreadcrumbs, serializeJsonLd } from '@/utils/seo';

const years = totalYears();

const description = `Conseil AWS et Kubernetes : audit d'architecture, gouvernance multi-comptes et FinOps. Freelance à Lyon, ${years} ans d'expérience, en France et en Europe.`;

const breadcrumbs = buildBreadcrumbs([
  { name: 'Accueil', url: `${SITE.url}/` },
  { name: 'Conseil', url: `${SITE.url}/conseil/` },
]);

/** Déroulé d'une mission de conseil, du premier échange à la passation. */
const phases = [
  {
    step: '01',
    title: 'Cadrage',
    duration: '1 à 2 jours',
    detail:
      "Un échange sur votre objectif réel, vos contraintes et l'état actuel de la plateforme. À la fin, vous savez si un audit est nécessaire — parfois il ne l'est pas.",
  },
  {
    step: '02',
    title: 'Audit',
    duration: '1 à 3 semaines',
    detail:
      "Analyse de l'architecture, de la sécurité, des coûts et des pratiques d'exploitation. Chaque constat est accompagné de son impact et de son ordre de priorité.",
  },
  {
    step: '03',
    title: 'Conception',
    duration: 'variable',
    detail:
      "Proposition d'architecture argumentée : options envisagées, arbitrages retenus, coût estimé. Vous validez les décisions avant que quoi que ce soit soit construit.",
  },
  {
    step: '04',
    title: 'Mise en œuvre et passation',
    duration: 'selon périmètre',
    detail:
      "Implémentation avec vos équipes, documentation et formation au run. L'objectif est que vous puissiez reprendre la main sans moi.",
  },
] as const;

/** Périmètre technique couvert par le conseil. */
const domains = [
  {
    title: 'Architecture & scalabilité',
    items: [
      'Conception ou revue d’architecture AWS',
      'Découpage en comptes et isolation des environnements',
      'Migration et chemins de réversibilité',
      'Choix entre serverless, conteneurs et instances',
    ],
  },
  {
    title: 'Sécurité & conformité',
    items: [
      'IAM, rôles fédérés et moindre privilège',
      'Gouvernance multi-comptes : Organizations, SCP, Firewall Manager',
      'Durcissement Kubernetes : politiques réseau, admission control',
      'Exigences réglementaires : traçabilité, données sensibles',
    ],
  },
  {
    title: 'FinOps & exploitation',
    items: [
      'Analyse de la facture et postes de dérive',
      'Dimensionnement et politiques d’autoscaling',
      'Définition des standards d’exploitation',
      'Indicateurs de fiabilité et objectifs de service',
    ],
  },
] as const;
---

<BaseLayout
  title="Audit & conseil AWS Kubernetes"
  description={description}
  canonical={`${SITE.url}/conseil/`}
>
  {
    breadcrumbs && (
      <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)} />
    )
  }

  <section class="section page-hero">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="container">
      <SectionHeading
        eyebrow="Conseil"
        level="h1"
        title="Auditer, concevoir, puis"
        accent="vous rendre autonome."
        lede={`J'interviens sur des plateformes AWS et Kubernetes quand les décisions d'architecture doivent être tranchées, argumentées et assumées. ${years} ans d'expérience sur des parcs allant de quelques services à plus de 800 microservices.`}
      />
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Discuter de votre besoin</a>
        <a class="btn btn-ghost" href={PROFILES.linkedin} target="_blank" rel="noopener">
          Profil LinkedIn
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading
        eyebrow="Périmètre"
        title="Ce que couvre"
        accent="une mission de conseil."
      />
      <ul class="domain-grid">
        {
          domains.map((domain) => (
            <li class="card">
              <h3 class="card-title text-display-sm">{domain.title}</h3>
              <ul class="check-list">
                {domain.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Déroulé"
        title="Quatre étapes,"
        accent="un périmètre écrit à chaque fois."
        lede="Le déroulé s’adapte à la maturité de votre plateforme. Ce qui ne varie pas : vous savez ce qui est livré et à quel moment."
      />
      <ol class="phase-list">
        {
          phases.map((phase) => (
            <li class="phase">
              <span class="phase-step" aria-hidden="true">
                {phase.step}
              </span>
              <div class="phase-body">
                <div class="phase-head">
                  <h3 class="phase-title">{phase.title}</h3>
                  <span class="phase-duration">{phase.duration}</span>
                </div>
                <p class="phase-detail">{phase.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading
        eyebrow="Repères"
        title="Des plateformes"
        accent="qui ne sont pas des maquettes."
      />
      <ul class="proof-list">
        <li class="proof">
          <span class="proof-value">300+</span>
          <span class="proof-text">
            clusters Kubernetes dans le parc du groupe SNCF, dont j’ai conçu et
            dirigé la construction de services managés sur le cloud privé.
          </span>
        </li>
        <li class="proof">
          <span class="proof-value">800+</span>
          <span class="proof-text">
            microservices sur Azure et Kubernetes chez Seiitra, avec un plan
            d’action FinOps et des standards d’exploitation réutilisables.
          </span>
        </li>
        <li class="proof">
          <span class="proof-value">90+</span>
          <span class="proof-text">
            microservices Go que je conçois et exploite sur Hartza Capital, ma
            propre plateforme d’analyse de marchés financiers.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .phase-list {
    display: flex;
    flex-direction: column;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .phase {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    padding: 28px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .phase:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .phase-step {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-violet);
    padding-top: 4px;
  }

  .phase-body {
    flex: 1;
    min-width: 0;
  }

  .phase-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
  }

  .phase-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .phase-duration {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .phase-detail {
    margin: 12px 0 0;
    max-width: 72ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .proof-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px 40px;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .proof {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--color-hairline);
    padding-top: 20px;
  }

  .proof-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-cyan);
  }

  .proof-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
</style>
