---
/**
 * Page 404.
 *
 * Elle est présentée comme la réponse d'erreur brute d'un stockage objet AWS :
 * c'est le format qu'un développeur ou un architecte reconnaît immédiatement, et
 * il dit exactement ce qui s'est passé — la clé demandée n'existe pas sur ce
 * domaine. Le ton reste celui du site, mais l'analogie est technique plutôt que
 * décorative.
 *
 * Le fichier est exporté à la racine sous le nom `404.html`, que GitHub Pages
 * sert automatiquement sur une URL inconnue.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NAV_LINKS } from '@/consts';

/**
 * Identifiant de requête, au format des en-têtes AWS.
 *
 * Généré au build : il change à chaque déploiement, comme le ferait un vrai
 * identifiant côté service, sans dépendre d'un script côté navigateur.
 */
const requestId = Array.from({ length: 16 }, () =>
  '0123456789ABCDEF'[Math.floor(Math.random() * 16)],
).join('');

const hostId = `${requestId.slice(0, 8)}-${requestId.slice(8)}-AMS`;

/** Destinations proposées pour repartir depuis la page d'erreur. */
const recoveryLinks = [
  { href: '/', label: 'Accueil', detail: 'Conseil et infogérance AWS/Kubernetes' },
  { href: '/conseil/', label: 'Conseil', detail: 'Audit et architecture cloud' },
  { href: '/infogerance/', label: 'Infogérance', detail: 'Exploitation de plateformes EKS' },
  { href: '/references/', label: 'Références', detail: 'Missions et contexte technique' },
] as const;
---

<BaseLayout
  title="404 — Ressource introuvable"
  description="La page demandée n'existe pas sur ce domaine. Liens vers les sections du site."
  noindex
>
  <section class="section error-page">
    <div class="ambient-glow" aria-hidden="true"></div>

    <div class="container error-inner">
      <p class="eyebrow eyebrow-aws">Erreur 404</p>
      <h1 class="text-display-xl error-title">
        Cette clé n’existe pas{' '}
        <span class="accent">dans ce bucket.</span>
      </h1>
      <p class="lede error-lede">
        La ressource demandée a été supprimée, déplacée, ou n’a jamais été
        publiée. Aucune action de votre côté n’est nécessaire.
      </p>

      <!-- Réponse d'erreur telle que la renverrait un stockage objet -->
      <div class="response" role="group" aria-label="Réponse d'erreur du service">
        <div class="response-bar">
          <span class="response-status">
            <span class="status-dot" aria-hidden="true"></span>
            HTTP/2 404 Not Found
          </span>
          <span class="response-service">AmazonS3</span>
        </div>

        <pre class="response-body"><code><span class="tag">&lt;?xml version="1.0" encoding="UTF-8"?&gt;</span>
<span class="tag">&lt;Error&gt;</span>
  <span class="key">&lt;Code&gt;</span><span class="value">NoSuchKey</span><span class="key">&lt;/Code&gt;</span>
  <span class="key">&lt;Message&gt;</span><span class="value">The specified key does not exist.</span><span class="key">&lt;/Message&gt;</span>
  <span class="key">&lt;Key&gt;</span><span class="value" id="requested-path">/chemin-inconnu</span><span class="key">&lt;/Key&gt;</span>
  <span class="key">&lt;RequestId&gt;</span><span class="value">{requestId}</span><span class="key">&lt;/RequestId&gt;</span>
  <span class="key">&lt;HostId&gt;</span><span class="value">{hostId}</span><span class="key">&lt;/HostId&gt;</span>
<span class="tag">&lt;/Error&gt;</span></code></pre>
      </div>

      <!-- Reprendre la navigation -->
      <nav class="recovery" aria-labelledby="recovery-title">
        <h2 class="recovery-title" id="recovery-title">Reprendre depuis une section connue</h2>
        <ul class="recovery-list">
          {
            recoveryLinks.map((link) => (
              <li>
                <a class="recovery-link" href={link.href}>
                  <span class="recovery-label">{link.label}</span>
                  <span class="recovery-detail">{link.detail}</span>
                  <span class="recovery-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="recovery-foot">
          Vous cherchiez autre chose ?
          <a href="/#contact">Écrivez-moi</a>, je vous oriente.
        </p>
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  // Affiche le chemin réellement demandé dans la réponse d'erreur. Sans script,
  // la valeur de repli reste lisible : la page fonctionne dans les deux cas.
  const pathSlot = document.getElementById('requested-path');
  if (pathSlot) {
    pathSlot.textContent = window.location.pathname;
  }
</script>

<style>
  .error-page {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-block: clamp(64px, 9vw, 120px);
  }

  .error-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 900px;
  }

  .eyebrow-aws {
    color: var(--color-aws);
  }

  .error-title {
    margin: 0;
    color: var(--color-ivory);
  }

  .accent {
    background: linear-gradient(100deg, var(--color-violet) 0%, var(--color-cyan) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .error-lede {
    margin: 0;
    max-width: 56ch;
  }

  /* ---------------------------------------------------- reponse d'erreur -- */

  .response {
    width: 100%;
    margin-top: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--color-ink-deep);
  }

  .response-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-surface);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.8125rem;
  }

  .response-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    color: var(--color-aws);
  }

  /* Pastille de statut, éteinte : la requête a échoué */
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-aws);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-aws) 22%, transparent);
  }

  .response-service {
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .response-body {
    margin: 0;
    padding: 20px 18px;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--color-muted);
    tab-size: 2;
    /* Le bloc reste lisible sur mobile : les lignes les plus longues passent à
       la ligne plutôt que d'être tronquées derrière un défilement horizontal. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .response-body code {
    font-family: inherit;
  }

  /* Balises et clés en cyan, valeurs en clair, comme dans un éditeur */
  .tag {
    color: var(--color-violet);
  }

  .key {
    color: var(--color-cyan);
  }

  .value {
    color: var(--color-ivory);
  }

  /* ------------------------------------------------------------ navigation -- */

  .recovery {
    width: 100%;
    margin-top: 28px;
  }

  .recovery-title {
    margin: 0 0 16px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .recovery-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recovery-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 2px 12px;
    padding: 16px 18px;
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    background-color: var(--color-surface);
    transition:
      border-color 0.25s,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .recovery-link:hover {
    border-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    transform: translateY(-2px);
  }

  .recovery-label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ivory);
  }

  .recovery-detail {
    grid-column: 1 / 2;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .recovery-arrow {
    grid-column: 2 / 3;
    grid-row: 1 / 3;
    align-self: center;
    color: var(--color-cyan);
    transition: transform 0.25s ease;
  }

  .recovery-link:hover .recovery-arrow {
    transform: translateX(4px);
  }

  .recovery-foot {
    margin: 20px 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .recovery-foot a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .recovery-list {
      grid-template-columns: 1fr;
    }
  }
</style>
