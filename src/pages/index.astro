---
/**
 * Page d'accueil : présentation des deux prestations, des preuves et de la
 * prise de contact.
 *
 * Elle sert de hub : elle capte la recherche de marque et le positionnement,
 * puis oriente vers les pages piliers qui répondent aux requêtes commerciales.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Services from '@/components/Services.astro';
import WhyUs from '@/components/WhyUs.astro';
import References from '@/components/References.astro';
import About from '@/components/About.astro';
import Faq from '@/components/Faq.astro';
import Contact from '@/components/Contact.astro';
import { SITE } from '@/consts';
import { totalYears, freelanceYears } from '@/utils/career';

const years = totalYears();
const independentYears = freelanceYears();

const description = `Freelance AWS et Kubernetes à Lyon : conseil en architecture cloud et infogérance de plateformes EKS. ${years} ans d'expérience, dont ${independentYears} en indépendant.`;
---

<BaseLayout
  title="Freelance AWS, Kubernetes & Ingénierie à Lyon"
  description={description}
  canonical={`${SITE.url}/`}
>
  <Hero />
  <Services />
  <WhyUs />
  <References limit={3} />
  <About />
  <Faq />
  <Contact />
</BaseLayout>
